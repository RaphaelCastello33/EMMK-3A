/* Configuration LoRa */
&lora {
    power-amplifier-output = "pa-boost";
};

/* Capteur I2C */
#include <zephyr/dt-bindings/gpio/sixtron-header.h>

&sixtron_i2c {
    status = "okay";

    mysensor: mysensor@76 {
        compatible = "catie,mysensor";
        reg = <0x76>;
        status = "okay";   /* <-- Obligatoire pour que DEVICE_DT_GET fonctionne */
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        storage_partition: partition@1f800 {
            label = "storage";
            reg = <0x0001f800 DT_SIZE_K(2)>; 
        };
    };
};
